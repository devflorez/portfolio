---
import '../styles/globals.css';
import { siteMetadata } from '../data/site';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props as Props;
const pageTitle = title ? `${title} | ${siteMetadata.name}` : siteMetadata.name;
const pageDescription = description ?? siteMetadata.description;
const canonicalUrl = canonical ?? siteMetadata.siteUrl ?? 'https://cristianflorez.co';
const ogImage = siteMetadata.ogImage ?? `${canonicalUrl}/og-image.png`;
const keywords = siteMetadata.keywords?.join(', ') ?? 'Full Stack Developer, Astro, Clean Architecture';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteMetadata.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteMetadata.twitterHandle ?? ''} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="image_src" href={ogImage} />
    <meta name="theme-color" content="#0B0D10" />
    <script type="application/ld+json">
      {{
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: siteMetadata.name,
        url: canonicalUrl,
        email: siteMetadata.email,
        sameAs: [siteMetadata.linkedin, siteMetadata.github],
        jobTitle: siteMetadata.roleEn,
        description: siteMetadata.descriptionEn,
        image: ogImage,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Rionegro',
          addressRegion: 'Antioquia',
          addressCountry: 'COL',
        },
      }}
    </script>
  </head>
  <body class="bg-dark text-offwhite" data-lang="en">
    <slot />
    <Analytics />
    <script type="module">
      (() => {
        const body = document.body;
        const buttons = () => Array.from(document.querySelectorAll('[data-lang-toggle]'));
        const storedLang = localStorage.getItem('preferredLang');
        const fallbackLang = navigator.language?.startsWith('es') ? 'es' : 'en';
        const initialLang = storedLang || fallbackLang;
        let pointerRAF;
        let pointerTimeout;

        const setLang = (lang) => {
          body.dataset.lang = lang;
          localStorage.setItem('preferredLang', lang);
          buttons().forEach((btn) => {
            btn.setAttribute('aria-pressed', String(lang === 'es'));
          });
        };

        window.toggleLanguage = () => {
          const next = body.dataset.lang === 'es' ? 'en' : 'es';
          setLang(next);
        };

        const updatePointer = (x, y) => {
          body.style.setProperty('--pointer-x', `${x}px`);
          body.style.setProperty('--pointer-y', `${y}px`);
        };

        const handlePointerMove = (event) => {
          if (pointerRAF) {
            cancelAnimationFrame(pointerRAF);
          }
          pointerRAF = requestAnimationFrame(() => {
            updatePointer(event.clientX, event.clientY);
            body.style.setProperty('--pointer-opacity', '0.8');
          });
          clearTimeout(pointerTimeout);
          pointerTimeout = setTimeout(() => {
            body.style.setProperty('--pointer-opacity', '0');
          }, 1000);
        };

        document.addEventListener('pointermove', handlePointerMove, { passive: true });
        document.addEventListener('pointerleave', () => {
          body.style.setProperty('--pointer-opacity', '0');
        });

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => setLang(initialLang));
        } else {
          setLang(initialLang);
        }

        body.style.setProperty('--pointer-opacity', '0');
      })();
    </script>
  </body>
</html>
